#encoding utf-8
#
# DC
#
DEF DC v 0 40 Y Y 1 F N
F0 "v" -200 100 60 H V C CNN
F1 "DC" -200 -50 60 H V C CNN
F2 "R1" -300 0 60 H V C CNN
F3 "" 0 0 60 H V C CNN
$FPLIST
 1_pin
$ENDFPLIST
DRAW
C 0 0 150 0 1 0 N
X + 1 0 450 300 D 50 50 1 1 w
X - 2 0 -450 300 U 50 50 1 1 w
ENDDRAW
ENDDEF
