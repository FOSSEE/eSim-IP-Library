* Control Statements 
.control
run
print allv > plot_data_v.txt
print alli > plot_data_i.txt


display
set xbrushwidth = 3

plot v(clk)+10v(rst) + 20v(left_bit) + 30v(right_bit) + 40v(mode1) + 50v(mode0)+60
plot v(parallel_in0)+10 v(parallel_in1)+20 v(parallel_in2)+30 v(parallel_in3)+40 v(parallel_in4)+50 v(parallel_in5)+60 v(parallel_in6)+70 v(parallel_in7) +80
plot v(parallel_out0)+10 v(parallel_out1)+20 v(parallel_out2)+30 v(parallel_out3)+40 v(parallel_out4)+50 v(parallel_out5)+60 v(parallel_out6)+70 v(parallel_out7) + 80 v(serial_out)+90



.endc
.end
