* Schematic Name:                             adc_bridge_2, NgSpice Name: adc_bridge
.model u2 adc_bridge(in_low=1.0 in_high=2.0 rise_delay=1.0e-9 fall_delay=1.0e-9 ) 
* Schematic Name:                             dac_bridge_8, NgSpice Name: dac_bridge
.model u13 dac_bridge(out_low=0.0 out_high=5.0 out_undef=0.5 input_load=1.0e-12 t_rise=1.0e-9 t_fall=1.0e-9 ) 
* Schematic Name:                             dac_bridge_8, NgSpice Name: dac_bridge
.model u9 dac_bridge(out_low=0.0 out_high=5.0 out_undef=0.5 input_load=1.0e-12 t_rise=1.0e-9 t_fall=1.0e-9 ) 
* Schematic Name:                             square_gen, NgSpice Name: square_gen
.model u1 square_gen(rise_delay=1.0e-9 fall_delay=1.0e-9 input_load=1.0e-12 instance_id=1 ) 
* Schematic Name:                             integrator, NgSpice Name: integrator
.model u4 integrator(rise_delay=1.0e-9 fall_delay=1.0e-9 input_load=1.0e-12 instance_id=1 ) 
.tran 10e-09 50e-06 0e-00

* Control Statements 
.control
run
let raw_in = (v(in7)/5)*128 + (v(in6)/5)*64 + (v(in5)/5)*32 + (v(in4)/5)*16 + (v(in3)/5)*8 + (v(in2)/5)*4 + (v(in1)/5)*2 + (v(in0)/5)*1
let raw_out = (v(out7)/5)*128 + (v(out6)/5)*64 + (v(out5)/5)*32 + (v(out4)/5)*16 + (v(out3)/5)*8 + (v(out2)/5)*4 + (v(out1)/5)*2 + (v(out0)/5)*1

set xbrushwidth=3      
set color0=black       
set color1=white
plot raw_in raw_out
.endc


.end
