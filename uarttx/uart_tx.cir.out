v9 tx_start gnd pulse(0 3.3 40n 1n 1n 10n 1000n)
v2 d1 gnd  dc 0
v1 d0 gnd  dc 1
v3 d2 gnd  dc 0
v4 d3 gnd  dc 1
a1 [net-_u2-pad9_ ] [net-_u2-pad10_ ] [net-_u2-pad11_ ] [net-_u2-pad12_ net-_u2-pad13_ net-_u2-pad14_ net-_u2-pad15_ net-_u2-pad16_ net-_u1-pad4_ net-_u1-pad5_ net-_u1-pad6_ ] [net-_u3-pad12_ ] [net-_u3-pad13_ ] u3
